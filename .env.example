# Copy to .env.local (never committed) and fill in from your Supabase project:
# Dashboard -> Project Settings -> API (Project URL and the Publishable key).
#
# Both values are public by design: they are sent to the browser and every request is
# still checked by Row Level Security. Never put the secret / service-role key here or
# in any NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional. The site's public URL, used for auth email links when the request origin
# can't be determined. Example: http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=
